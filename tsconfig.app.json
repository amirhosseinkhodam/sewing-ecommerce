{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "importHelpers": true,
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "types": []
  },
  "files": ["src/main.ts"]
}
