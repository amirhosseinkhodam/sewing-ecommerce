/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    /* The i18n dictionaries are imported as JSON modules. */
    "resolveJsonModule": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    /* TypeScript 6 enables `strict` by default, so it is not restated here.
       `baseUrl` is deprecated in TS6, so paths are resolved relative to this
       config file instead. */
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@features/*": ["./src/app/features/*"],
      /* Cross-half types shared with the NestJS backend live in the repo-root
         `shared/` folder. Aliased `@domain/*` because `@shared/*` already names
         this app's UI-shared folder (see PROJECT_KNOWLEDGE.md §3). */
      "@domain/*": ["../shared/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
