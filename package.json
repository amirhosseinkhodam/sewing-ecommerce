    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.6",
    "@ng-select/ng-select": "^24.1.2",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@spartan-ng/brain": "^1.4.1",
    "@tanstack/angular-query-experimental": "^5.103.2",
