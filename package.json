{
  "name": "sewing-ecommerce",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "prisma generate && nest build",
    "build:frontend": "ng build",
    "start": "ng serve",
    "start:frontend": "ng serve",
    "start:backend": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/backend/src/main",
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run start:frontend\" \"npm run start:backend\"",
    "lint": "eslint \"frontend/src/**/*.ts\" \"backend/src/**/*.ts\" \"shared/**/*.ts\" --fix",
    "format": "prettier --write \"frontend/src/**/*.ts\" \"backend/src/**/*.ts\" \"shared/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config backend/jest.config.ts",
    "test:backend:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config backend/jest.config.ts --coverage",
    "test:frontend": "ng test --watch=false",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@hugeicons/angular": "^1.0.10",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@ng-select/ng-select": "^24.1.2",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@spartan-ng/brain": "^1.4.1",
    "@tanstack/angular-query-experimental": "^5.103.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.12"
  }
}
