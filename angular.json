{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "sewing-ecommerce": {
      "projectType": "application",
      "root": "frontend",
      "sourceRoot": "frontend/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/frontend",
            "index": "frontend/src/index.html",
            "browser": "frontend/src/main.ts",
            "tsConfig": "tsconfig.frontend.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "frontend/public"
              }
            ],
            "styles": [
              "frontend/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "serviceWorker": "frontend/ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "sewing-ecommerce:build",
            "proxyConfig": "frontend/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "sewing-ecommerce:build:production"
            },
            "development": {
              "buildTarget": "sewing-ecommerce:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.frontend.spec.json",
            "buildTarget": "sewing-ecommerce:build:development",
            "runner": "vitest",
            "include": [
              "../tests/**/*.spec.ts"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
