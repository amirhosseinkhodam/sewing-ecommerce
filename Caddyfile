# TLS-terminating reverse proxy in front of the app container.
# DOMAIN comes from .env.production; Caddy obtains and renews the Let's Encrypt
# certificate on its own, provided DNS points here and ports 80/443 are open.
# DOMAIN=localhost serves a locally trusted (self-signed) certificate instead.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
